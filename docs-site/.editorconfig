root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 2

# Same as the Prettier overrides in .prettierrc.json.
[{*.{md,mdx,yml,yaml},package.json}]
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false
