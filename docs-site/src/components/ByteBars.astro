---
/**
 * Horizontal bars comparing frame sizes, for example the same message in
 * several encodings. Bars grow in as they scroll into view.
 *
 * <ByteBars bars={[{ label: 'default', bytes: 64 }, { label: 'compact', bytes: 4 }]} />
 *
 * Labels are shown in the code font: use encoding or attribute names. The
 * numbers are visible text, so the chart needs no separate description.
 */
import type { FieldColor } from '../lib/wire';

interface Bar {
	label: string;
	bytes: number;
}

interface Props {
	bars: Bar[];
}

const { bars } = Astro.props;
const max = Math.max(...bars.map(({ bytes }) => bytes));
const COLORS: readonly FieldColor[] = ['f1', 'f2', 'f3', 'f4'];
---

<ul class="byte-bars not-content">
	{bars.map(({ label, bytes }, index) => (
		<li class={`qsl-c-${COLORS[index % COLORS.length]}`} style={`--share: ${bytes / max}`}>
			<code>{label}</code>
			<span class="byte-bars__track" aria-hidden="true">
				<span class="byte-bars__fill" />
			</span>
			<span class="byte-bars__value">{bytes} B</span>
		</li>
	))}
</ul>

<style>
	.byte-bars {
		display: grid;
		gap: 0.625rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	li {
		display: grid;
		grid-template-columns: 5.5rem minmax(0, 1fr) 3.5rem;
		align-items: center;
		gap: 1rem;
		margin: 0;
	}

	code {
		padding: 0;
		border: 0;
		background: none;
		color: var(--c);
		font-size: var(--sl-text-xs);
	}

	.byte-bars__track {
		height: 0.75rem;
		border-radius: 999px;
		background: var(--sl-color-gray-6);
	}

	.byte-bars__fill {
		display: block;
		/* Never thinner than a dot, so small frames stay visible. */
		width: max(0.75rem, calc(var(--share) * 100%));
		height: 100%;
		border-radius: inherit;
		background: var(--c);
		transform-origin: left;
	}

	:root[dir='rtl'] .byte-bars__fill {
		transform-origin: right;
	}

	.byte-bars__value {
		color: var(--sl-color-white);
		font-family: var(--__sl-font-mono);
		font-size: var(--sl-text-xs);
		font-variant-numeric: tabular-nums;
		text-align: end;
	}

	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			.byte-bars__fill {
				animation: byte-bars-grow linear both;
				animation-timeline: view();
				animation-range: entry 20% cover 45%;
			}
		}
	}

	@keyframes byte-bars-grow {
		from {
			transform: scaleX(0);
		}
	}

	@media (forced-colors: active) {
		.byte-bars__fill {
			background: CanvasText;
			forced-color-adjust: none;
		}
	}
</style>
