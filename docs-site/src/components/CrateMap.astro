---
/**
 * The QSL crates and the direction of their dependencies, for the
 * architecture page. Each arrow reads "depends on".
 *
 *   Wide:                                        Narrow:
 *   qsl → qsl-interpreter → qsl-lexer → qsl-core     qsl → qsl-macros-impl
 *    ↓                                                ↓
 *   qsl-macros-impl                                  qsl-interpreter
 *                                                     ↓ ...
 *
 * The facade also depends on every crate directly. The drawing shows the
 * chain that matters when reading the code, and the table below it lists
 * every edge. Because it repeats the table, it is hidden from screen
 * readers. Crate names are identifiers and are not translated.
 *
 * Arrows are elements of their own between the boxes, so they touch both
 * ends whatever the box widths are. The facade box and the arrows that
 * leave it downward share one width, which keeps those arrows centered
 * under it.
 */
const CHAIN = ['qsl-interpreter', 'qsl-lexer', 'qsl-core'];
---

<div class="crate-map not-content" aria-hidden="true">
	<div class="crate-map__spine">
		<div class="crate-map__head">
			<code class="node node--facade" style="--i: 0">
				qsl
			</code>
			<span class="arrow arrow--side" style="--i: 1"></span>
			<code class="node node--side" style="--i: 1">
				qsl-macros-impl
			</code>
		</div>
		{CHAIN.map((name, index) => (
			<>
				<span class="arrow arrow--main" style={`--i: ${index + 1}`} />
				<code class="node" style={`--i: ${index + 1}`}>
					{name}
				</code>
			</>
		))}
	</div>
</div>

<style>
	.crate-map {
		--node-h: 2.375rem;
		--facade-w: 3.5rem;
		--arrow-len: 2.5rem;
		--arrow-color: color-mix(in oklab, var(--sl-color-gray-3) 75%, transparent);
		container-type: inline-size;
		padding: 1.75rem 1.5rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 14px;
		background: var(--qsl-surface);
	}

	/* Narrow: the chain runs down the page, the macros crate sits beside qsl. */
	.crate-map__spine {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.crate-map__head {
		display: flex;
		align-items: center;
	}

	.node {
		display: inline-flex;
		align-items: center;
		block-size: var(--node-h);
		padding: 0 0.875rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 9px;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
		font-size: var(--sl-text-sm);
		white-space: nowrap;
	}

	.node--facade {
		justify-content: center;
		inline-size: var(--facade-w);
		padding: 0;
		border-color: color-mix(in oklab, var(--sl-color-accent) 60%, transparent);
		background: color-mix(in oklab, var(--sl-color-accent) 12%, var(--sl-color-gray-6));
		color: var(--sl-color-text-accent);
	}

	.node--side {
		background: transparent;
		color: var(--sl-color-gray-2);
	}

	/*
	 * An arrow is a line (::before) ending in an open chevron (::after). Each
	 * layout below sets the direction of the main and side arrows.
	 */
	.arrow {
		position: relative;
		flex: none;
	}

	.arrow::before,
	.arrow::after {
		content: '';
		position: absolute;
	}

	.arrow::after {
		inline-size: 7px;
		block-size: 7px;
		border-block-end: 1px solid var(--arrow-color);
		border-inline-end: 1px solid var(--arrow-color);
	}

	.arrow::before {
		background: var(--arrow-color);
	}

	/* Narrow: main arrows point down, centered under the facade box. */
	.arrow--main {
		inline-size: var(--facade-w);
		block-size: var(--arrow-len);
	}

	.arrow--main::before {
		inset-block: 0.375rem 0.4375rem;
		inset-inline-start: calc(50% - 0.5px);
		inline-size: 1px;
		transform-origin: top;
	}

	.arrow--main::after {
		inset-block-end: 0.4375rem;
		inset-inline-start: calc(50% - 3.5px);
		rotate: 45deg;
	}

	.arrow--side {
		inline-size: var(--arrow-len);
		block-size: var(--node-h);
	}

	.arrow--side::before {
		inset-block-start: calc(50% - 0.5px);
		inset-inline: 0.375rem 0.4375rem;
		block-size: 1px;
		transform-origin: left;
	}

	.arrow--side::after {
		inset-block-start: calc(50% - 3.5px);
		inset-inline-end: 0.4375rem;
		rotate: -45deg;
	}

	/* Wide: the chain runs along the row, the macros crate hangs below qsl. */
	@container (min-width: 38rem) {
		.crate-map__spine {
			flex-direction: row;
			justify-content: center;
		}

		/*
		 * The column is as wide as qsl, so the chain starts right after it;
		 * the wider macros box below overflows into the empty row.
		 */
		.crate-map__head {
			flex-direction: column;
			align-items: flex-start;
			inline-size: var(--facade-w);
		}

		.arrow--main {
			inline-size: var(--arrow-len);
			block-size: var(--node-h);
		}

		.arrow--main::before {
			inset-block: calc(50% - 0.5px) auto;
			inset-inline: 0.375rem 0.4375rem;
			inline-size: auto;
			block-size: 1px;
			transform-origin: left;
		}

		.arrow--main::after {
			inset-block: calc(50% - 3.5px) auto;
			inset-inline: auto 0.4375rem;
			rotate: -45deg;
		}

		.arrow--side {
			inline-size: var(--facade-w);
			block-size: var(--arrow-len);
		}

		.arrow--side::before {
			inset-block: 0.375rem 0.4375rem;
			inset-inline: calc(50% - 0.5px) auto;
			inline-size: 1px;
			block-size: auto;
			transform-origin: top;
		}

		.arrow--side::after {
			inset-block: auto 0.4375rem;
			inset-inline: calc(50% - 3.5px) auto;
			rotate: 45deg;
		}
	}

	/* Chevrons along the row point the other way in right-to-left pages. */
	:root[dir='rtl'] .arrow--side::after {
		rotate: 135deg;
	}

	:root[dir='rtl'] .arrow::before {
		transform-origin: right;
	}

	@container (min-width: 38rem) {
		:root[dir='rtl'] .arrow--main::after {
			rotate: 135deg;
		}

		:root[dir='rtl'] .arrow--side::after {
			rotate: 45deg;
		}

		:root[dir='rtl'] .arrow--side::before {
			transform-origin: top;
		}
	}

	/*
	 * Scrolling the map into view builds it in reading order: each box fades
	 * in, then the arrow leaving it draws itself toward the next one.
	 */
	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			.crate-map__spine {
				view-timeline: --crate-map;
			}

			.node {
				animation: crate-map-node linear both;
				animation-timeline: --crate-map;
				animation-range: entry calc(15% + var(--i) * 12%) entry calc(40% + var(--i) * 12%);
			}

			.arrow::before {
				animation: crate-map-line linear both;
				animation-timeline: --crate-map;
				animation-range: entry calc(25% + var(--i) * 12%) entry calc(45% + var(--i) * 12%);
			}

			.arrow::after {
				animation: crate-map-head linear both;
				animation-timeline: --crate-map;
				animation-range: entry calc(38% + var(--i) * 12%) entry calc(46% + var(--i) * 12%);
			}
		}
	}

	@keyframes crate-map-node {
		from {
			opacity: 0;
			translate: 0 6px;
		}
	}

	@keyframes crate-map-line {
		from {
			scale: 0;
		}
	}

	@keyframes crate-map-head {
		from {
			opacity: 0;
		}
	}

	@media (forced-colors: active) {
		.arrow::before {
			background: CanvasText;
		}

		.arrow::after {
			border-color: CanvasText;
		}
	}
</style>
