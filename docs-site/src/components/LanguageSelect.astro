---
/**
 * Override of Starlight's `LanguageSelect`.
 *
 * A disclosure button with the current language code opens a list of links
 * to the same page in every language. The links work without JavaScript; the
 * script closes the list on an outside click or Escape and remembers the
 * chosen language, which `/QSL/` (src/pages/index.astro) opens next time. A native
 * `<select>` resized itself with the language name, which shifted the header.
 *
 * On the 404 page the links go to each language's home page, because the
 * 404 page exists only once.
 */
import { DEFAULT_LOCALE, LOCALES } from '../../config/site.mjs';
import { switchLocalePath } from '../lib/links.mjs';

const { starlightRoute, t } = Astro.locals;
const base = import.meta.env.BASE_URL;
const current = starlightRoute.locale ?? DEFAULT_LOCALE;
const isNotFound = starlightRoute.id === '404';

const languages = Object.entries(LOCALES).map(([key, { label, lang }]) => {
	const href = isNotFound
		? switchLocalePath(base, { base, from: undefined, to: key })
		: switchLocalePath(Astro.url.pathname, { base, from: starlightRoute.locale, to: key });
	return { key, label, lang, href, code: lang.split('-')[0].toUpperCase() };
});
const active = languages.find(({ key }) => key === current) ?? languages[0];
---

<qsl-language-select>
	<details class="qsl-lang">
		<summary aria-label={`${t('languageSelect.accessibleLabel')}: ${active.label}`}>
			<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
				<circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.3"></circle>
				<path
					d="M1.75 8h12.5M8 1.75c1.9 1.7 2.8 3.8 2.8 6.25S9.9 12.55 8 14.25M8 1.75C6.1 3.45 5.2 5.55 5.2 8s.9 4.55 2.8 6.25"
					fill="none"
					stroke="currentColor"
					stroke-width="1.3"
				></path>
			</svg>
			<span class="qsl-lang__code" aria-hidden="true">
				{active.code}
			</span>
		</summary>
		<ul class="qsl-lang__list">
			{languages.map(({ key, label, lang, href }) => (
				<li>
					<a
						href={href}
						hreflang={lang}
						lang={lang}
						data-locale={key}
						aria-current={key === current ? 'true' : undefined}
					>
						{label}
					</a>
				</li>
			))}
		</ul>
	</details>
</qsl-language-select>

<script>
	import { LOCALE_STORAGE_KEY } from '../lib/locale';

	class QslLanguageSelect extends HTMLElement {
		connectedCallback(): void {
			const details = this.querySelector('details');
			if (!details) return;
			const close = () => details.removeAttribute('open');
			document.addEventListener('click', (event) => {
				if (details.open && !details.contains(event.target as Node)) close();
			});
			details.addEventListener('keydown', (event) => {
				if (event.key !== 'Escape' || !details.open) return;
				close();
				details.querySelector('summary')?.focus();
			});
			details.addEventListener('click', (event) => {
				const locale = (event.target as Element).closest<HTMLElement>('[data-locale]')?.dataset.locale;
				if (!locale) return;
				try {
					localStorage.setItem(LOCALE_STORAGE_KEY, locale);
				} catch {
					// Without storage the entry point opens English.
				}
			});
		}
	}

	customElements.define('qsl-language-select', QslLanguageSelect);
</script>

<style>
	.qsl-lang {
		position: relative;
	}

	summary {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		justify-content: center;
		min-width: var(--qsl-control-inline, 2.25rem);
		height: var(--qsl-control-block, 2.25rem);
		padding-inline: var(--qsl-control-pad, 0.55rem 0.65rem);
		border-radius: var(--qsl-control-radius, 9px);
		color: var(--sl-color-gray-2);
		cursor: pointer;
		list-style: none;
		user-select: none;
		transition:
			color 160ms ease,
			background-color 160ms ease;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary:hover,
	details[open] summary {
		color: var(--sl-color-white);
		background: var(--sl-color-gray-6);
	}

	.qsl-lang__code {
		/* Fixed width: switching languages never moves the neighbouring controls. */
		min-width: 2ch;
		font-family: var(--__sl-font-mono);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.04em;
	}

	.qsl-lang__list {
		position: absolute;
		z-index: 1;
		inset-inline-end: 0;
		inset-block-start: calc(100% + var(--qsl-popover-offset, 0.5rem));
		display: grid;
		gap: 1px;
		min-width: 12rem;
		margin: 0;
		padding: 0.375rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: var(--qsl-popover-radius, 12px);
		background: color-mix(in oklab, var(--qsl-surface) 88%, transparent);
		backdrop-filter: blur(18px) saturate(160%);
		-webkit-backdrop-filter: blur(18px) saturate(160%);
		box-shadow: 0 24px 60px -20px rgb(0 0 0 / 0.5);
		list-style: none;
		transform-origin: top right;
	}

	details[open] .qsl-lang__list {
		animation: qsl-menu-in 220ms var(--qsl-ease-out) both;
	}

	.qsl-lang__list li {
		margin: 0;
	}

	.qsl-lang__list a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.45rem 0.65rem;
		border-radius: 8px;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		text-decoration: none;
		transition:
			color 140ms ease,
			background-color 140ms ease;
	}

	.qsl-lang__list a:hover {
		color: var(--sl-color-white);
		background: var(--sl-color-gray-6);
	}

	.qsl-lang__list a[aria-current='true'] {
		color: var(--sl-color-white);
		font-weight: 560;
	}

	.qsl-lang__list a[aria-current='true']::after {
		content: '';
		width: 6px;
		height: 6px;
		border-radius: 1.5px;
		background: var(--sl-color-accent);
	}

	@keyframes qsl-menu-in {
		from {
			opacity: 0;
			transform: translateY(-4px) scale(0.97);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		details[open] .qsl-lang__list {
			animation: none;
		}
	}
</style>
