&Plain { u32 id; str text; array<u8> bytes; u8? flag; }
&Text { str text; }
&Bytes { array<u8> bytes; }
&Fixed { str(4) text; array<u8>(3) bytes; }
&Compact[compact] { u8(1..3) tag; str(0..31) text; array<u8>(0..31) bytes; u8? flag; }
&Compressed { str(1..255) first|decompress=true|; str(1..255) second|decompress=true|; }
&Guard { str text|binary_opt=guard|; }
&Borrowed[lifetime] { str text; array<u8> bytes; }
&Optional[opt_table] { u32 id; str?(1..31) text; u8? flag; }
&Sequential[predict_seq] { u32 id; u8? flag; }
&State[state_bits] { u8? first; u16? second; }
&Directory[opt_table=legacy] { u32 id; u8? first; u16? second; }
&Packed[qps] { u64(0..15) a; u64(0..15) b; }
&Custom { Counted first; str text; }
&Empty { }
