&OwnedText[safety] { str(1..4096) text; }
&BorrowedText[lifetime,safety] { str(1..4096) text; }
&GuardText[safety] { str(1..4096) text|binary_opt=guard|; }
&InlineText[safety] { str(1..4096) text|binary_opt=inline|; }
&CompressedText[safety] { str(1..4096) text|decompress=true|; }
&FixedText[safety] { str(4) text; }
