&Plain[safety]{u32 id;str(1..100) text;array<u8>(0..16) data;u8? a;u16? b;}
&Stack[aggressive,safety]{u32 id;str(1..100) text;array<u8>(0..16) data;u8? a;u16? b;}
&Graph[predict_seq,opt_table,aggressive,safety]{u32 id;str?(1..8) a;str?(2..16) b;}
&Numeric[qps,safety]{u64(0..15) a;u64(0..15) b;u64?(1..15) c;}
&Trusted{u32 id;}
&RT[slots=2,safety]{u32 id;}
&CopyNative[transmutate,safety]{u64 id;u32 value;str(4) tag;}
&Overlay[transmutate,lifetime,safety]{u64 id;u32 value;str(4) tag;}
&Cache[safety,loyal_cache]{u64 id;str(1..16) text;}
&Compressed[aggressive,safety]{str(3..255) text|decompress=true|;}
&Region[safety]{#region(aggressive_transmutate = "Meta");u64 id;u32 value;str(4) tag;#end_region;str(1..8) name;}
&Hybrid[qps,safety,aggressive]{u64(0..15) a;u64(0..15) b;str(1..32) text;array<u32>(0..4) data;}
&ArrayStack[aggressive,safety]{array<u32>(0..4) values;array<u16>(3) fixed;}
&HybridOptional[qps,safety,aggressive]{u64(0..15) id;u64?(0..15) count;str?(1..8) text;}
&HeapLz[safety]{str(3..1024) text|decompress=true|;}
&HeapInline[safety]{str(1..1024) text|binary_opt=inline|;}
&HeapFixed[safety]{str(1024) text;array<u16>(200) values;}
&BorrowInline[lifetime,safety]{str(3) tag;str(1..1024) text|binary_opt=inline|;}
&CompactArray[aggressive,compact,safety]{u8(0..7) id;array<u32>(0..4) values;array<u16>(3) fixed;}

&Table[safety,opt_table]{u64 id;u8? a;u16? b;u32? c;}
&Niches[safety,aggressive]{u8?(1..) positive;i16?(-9..-1) negative;i32?(-10..10) shifted;u8? full;}
&NestedRegion[safety]{Nested nested;str(1..8) name;}
&Nine[safety]{u64 id;str(1..100) text|binary_opt=inline|;}
&WideQ2[qps=Q2,safety,aggressive]{u64(0..1000) id;i64(-100..100) signed;u64?(0..15) a;u64?(1..65535) b;}
&WideQ4[qps=Q4,safety,aggressive]{u64(0..1000) id;i64(-100..100) signed;u64?(0..15) a;u64?(1..65535) b;}
&WideQ8[qps=Q8,safety,aggressive]{u64(0..1000) id;i64(-100..100) signed;u64?(0..15) a;u64?(1..65535) b;}
&WideQ16[qps=Q16,safety,aggressive]{u64(0..1000) id;i64(-100..100) signed;u64?(0..15) a;u64?(1..65535) b;}
&Many[safety,opt_table]{u8? f0;u8? f1;u8? f2;u8? f3;u8? f4;u8? f5;u8? f6;u8? f7;u8? f8;u8? f9;u8? f10;u8? f11;u8? f12;u8? f13;u8? f14;u8? f15;u8? f16;u8? f17;u8? f18;u8? f19;u8? f20;u8? f21;u8? f22;u8? f23;u8? f24;u8? f25;u8? f26;u8? f27;u8? f28;u8? f29;u8? f30;u8? f31;u8? f32;u8? f33;u8? f34;u8? f35;u8? f36;u8? f37;u8? f38;u8? f39;u8? f40;u8? f41;u8? f42;u8? f43;u8? f44;u8? f45;u8? f46;u8? f47;u8? f48;u8? f49;u8? f50;u8? f51;u8? f52;u8? f53;u8? f54;u8? f55;u8? f56;u8? f57;u8? f58;u8? f59;u8? f60;u8? f61;u8? f62;u8? f63;}

&BorrowNative[lifetime,safety]{#region(aggressive_transmutate = "ArrayMeta");array<u16>(3) values;#end_region;str(1..8) text;}

&LargeCache[safety,loyal_cache]{str(1..65535) text;}

&PaddedNeighbor[safety]{PaddedMeta meta;u8 neighbor;}

&CopyTrusted[transmutate]{u64 id;u32 value;str(4) tag;}
&OverlayTrusted[transmutate,lifetime]{u64 id;u32 value;str(4) tag;}
&RegionTrusted{#region(aggressive_transmutate = "Meta");u64 id;u32 value;str(4) tag;#end_region;}
&CountedRegion[safety]{#region(aggressive_transmutate = "CountedMeta");u64 id;u32 value;str(4) tag;#end_region;}

&CopyFallback[transmutate,safety]{u8 tag;u64 id;}

&RegisterCross[safety]{u64 head;u32 middle;u16 short;u8 byte;i64 crossing;u8 tail;}
&HeaderCross[safety]{u64 head;u32 middle;u16 short;u8 byte;str(1..1024) text;}
&QpsCross[qps,safety]{u8(0..1) bit;u64? wide;u64?(0..15) small;}
